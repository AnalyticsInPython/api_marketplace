# Shared trusted-LAN demo key. Change it for your network; empty disables auth.
MARKETPLACE_API_KEY=dev-marketplace-key

DATABASE_URL=sqlite:///./marketplace.db
REQUEST_TIMEOUT_SECONDS=120
HEALTH_TIMEOUT_SECONDS=3
HEALTH_POLL_SECONDS=10
EVENT_HISTORY_LIMIT=100
MAX_PROMPT_CHARACTERS=50000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Private IPv4 and .local dashboard origins are allowed by default. Override
# the regex to restrict the dashboard to specific LAN hosts.
ALLOWED_ORIGIN_REGEX=
