# ---------------------------------------------------------------------------
# Local LLM Marketplace — Dashboard configuration
# Copy this file to `.env.local` and adjust for your central server.
# All NEXT_PUBLIC_* vars are exposed to the browser (safe for a local POC only).
# ---------------------------------------------------------------------------

# "auto" uses the dashboard page hostname with port 8000. This works on the
# router Mac and when another computer opens http://<router-ip>:3000.
NEXT_PUBLIC_API_BASE_URL=auto

# "auto" uses ws://<dashboard-host>:8000/ws/dashboard.
NEXT_PUBLIC_WS_URL=auto

# Shared marketplace API key. Only needed if the dashboard endpoints require it.
NEXT_PUBLIC_API_KEY=
